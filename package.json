{
  "name": "bolt-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "expo": "expo start",
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "android": "expo run:android",
    "android:release": "set NODE_OPTIONS=--max-old-space-size=8192 && expo run:android --variant release",
    "android:clean": "cd android && .\\gradlew clean && cd .. && expo run:android --clear",
    "build:android": "set NODE_OPTIONS=--max-old-space-size=8192 && eas build --platform android --profile production",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/image-utils": "^0.7.6",
    "@expo/vector-icons": "^14.1.0",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@tanstack/react-query": "^5.83.0",
    "axios": "^1.11.0",
    "expo": "~53.0.23",
    "expo-auth-session": "^6.2.1",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.3",
    "expo-device": "^7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.3",
    "expo-notifications": "~0.31.4",
    "expo-router": "~5.1.6",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "^0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-store-review": "~8.1.5",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "5.0.11",
    "expo-updates": "~0.28.17",
    "expo-web-browser": "~14.2.0",
    "lucide-react-native": "^0.475.0",
    "onesignal-expo-plugin": "^2.0.3",
    "path-browserify": "^1.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-async-storage": "^0.0.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-onesignal": "^5.2.13",
    "react-native-paper": "^5.14.5",
    "react-native-permissions": "^5.4.2",
    "react-native-push-notification": "^8.1.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-share": "^12.2.0",
    "react-native-svg": "15.11.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.20.0",
    "react-native-webview": "^13.13.5",
    "react-onesignal": "^3.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.0.1",
    "@react-native/eslint-config": "^0.80.2",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit",
          "react-native-push-notification",
          "@lucide/lab",
          "path-browserify",
          "react-native-async-storage",
          "react-native-vector-icons",
          "react-onesignal"
        ]
      }
    }
  }
}
